#!/usr/bin/env bash
# ============================================================================
# pearos-update — bring an installed (or live) pearOS up to the latest build
# without reflashing the USB.
#
#   pearos-update            # optimizations + theming from GitHub + pkgs
#   pearos-update --full     # also runs 'pacman -Syu' (kernel/plasma/apps)
#
# How it works: the build machine (GitHub Actions) publishes the current
# optimization stack to this repo. Here we sync those scripts over the old
# ones, re-apply system-level config (sysctls, services, module options),
# and optionally upgrade packages. Theming/user config is re-applied per user
# via pear-ui-polish.
# ============================================================================
set -uo pipefail

REPO_RAW="https://raw.githubusercontent.com/Numanhacks/pearos-custom/main"
OPT_LIB="/usr/local/lib/pearos-opt"
FULL=0
DRY_RUN=0
for arg in "$@"; do
    case "$arg" in
        --full) FULL=1 ;;
        --dry-run) DRY_RUN=1 ;;
    esac
done

log()  { echo -e "\033[92m[pearos-update]\033[0m $*"; }
warn() { echo -e "\033[93m[pearos-update]\033[0m $*"; }

if (( DRY_RUN )); then
    log "[dry-run] would sync optimization suite + UI plasmoids (no files touched)"
fi

[ "$(id -u)" -eq 0 ] || { warn "Run as root: sudo pearos-update"; exit 1; }

sync_plasmoid_qml() {
    local src_prefix="$1"
    local inst_base="$2"
    local inst_ui="$inst_base/contents/ui"
    mkdir -p "$inst_ui" 2>/dev/null || true
    local files="main.qml Task.qml TaskBadgeOverlay.qml TaskProgressOverlay.qml GroupDialog.qml ContextMenu.qml PulseAudio.qml code/LayoutMetrics.js code/TaskTools.js code/DockZoom.js"
    for rel in $files; do
        local url="$REPO_RAW/$src_prefix/$rel"
        local dest="$inst_ui/$rel"
        if ! curl -fsSL -I "$url" >/dev/null 2>&1; then
            warn "  -> $rel not found at $url (skip)"
            continue
        fi
        mkdir -p "$(dirname "$dest")"
        if curl -fsSL --retry 2 -o "$dest" "$url"; then
            log "  -> synced $rel"
        else
            warn "  -> could not fetch $rel (skip)"
        fi
    done
}

mkdir -p "$OPT_LIB"

# ---- 1) Sync latest optimization scripts from the build repo ---------------
log "Fetching latest optimization suite from Numanhacks/pearos-custom..."
FILES="memory-optimizer/optimize-memory.sh memory-optimizer/restore-defaults.sh \
memory-optimizer/oomd-protect.sh memory-optimizer/99-macos-memory.conf \
memory-optimizer/oomd.conf memory-optimizer/oomd-drop.conf \
memory-optimizer/oomd-managed.slice.conf memory-optimizer/app-nap-daemon.py \
memory-optimizer/app-nap.service memory-optimizer/ksm-activate.sh \
memory-optimizer/ksm.service memory-optimizer/ksm.timer \
memory-optimizer/pearos-preload.sh memory-optimizer/pearos-preload.service \
memory-optimizer/pearos-memory-polish.service memory-optimizer/50-pearos.rules \
memory-optimizer/99-pearos-net.conf \
performance-suite/install-performance.sh performance-suite/cpu-performance.sh \
performance-suite/irq-balance.sh performance-suite/io-scheduler.sh \
performance-suite/gpu-compute-optimize.sh performance-suite/thermal-manager.sh \
performance-suite/compile-flags.sh performance-suite/99-pearos-net.conf \
desktop-experience/install-desktop-experience.sh \
macos-ui-polish/pear-ui-polish.sh macos-ui-polish/pearos-global-smoothness.sh \
surface-support/install-surface-support.sh"
FAIL=0
for f in $FILES; do
    dest="$OPT_LIB/$(basename "$f")"
    if (( DRY_RUN )); then
        echo "[dry-run] curl -fsSL --retry 3 -o $dest $REPO_RAW/$f"
        continue
    fi
    if ! curl -fsSL --retry 3 -o "$dest" "$REPO_RAW/$f"; then
        warn "could not fetch $f (404 or network) — skipping"
        FAIL=1
        continue
    fi
    chmod +x "$dest" 2>/dev/null || true
done
if (( FAIL )); then
    warn "some files failed to download — continuing with what we got"
fi

# ---- 2) Re-apply system-level config (idempotent) --------------------------
log "Re-applying system tuning (sysctl, services, module options)..."
bash "$OPT_LIB/optimize-memory.sh" 2>&1 | grep -E "INFO|WARN|ERROR" || true
bash "$OPT_LIB/install-performance.sh" 2>&1 | grep -E "^\[" || true
sysctl --system >/dev/null 2>&1 || true

# module options can change too
find /etc/modprobe.d -name "*.conf" -newer /var/lib/pearos-update.stamp 2>/dev/null | \
    xargs -r mkinitcpio -P 2>/dev/null || true

# ---- 3) Per-user theming refresh -------------------------------------------
if [ -f /usr/local/bin/pear-ui-polish ]; then
    log "Refreshing macOS theming for all users..."
    bash /usr/local/bin/pear-ui-polish --config-only 2>/dev/null \
        || bash /usr/local/bin/pear-ui-polish 2>/dev/null || true
fi

# ---- 3b) Ship UI component changes (dock/notch/plasmoids) -------------------
# The dock is a QML plasmoid (PearDock); notch is a standalone Qt app.
# Sync installed copies from the build repo so interface fixes land without a
# reflash, then restart plasmashell. Resilient: 404 is a warning, not a crash.
if (( DRY_RUN )); then
    log "[dry-run] would sync PearDock QML: pkgbuilds/pearos-dock/package/contents/ui -> /usr/share/plasma/plasmoids/PearDock/contents/ui/"
else
    # PearDock — CORRECT id is PearDock (not org.kde.plasma.pearos-dock)
    if [ -d /usr/share/plasma/plasmoids/PearDock ] || [ -d /usr/share/plasma/plasmoids/PearDock/contents ]; then
        log "Syncing PearDock from build repo..."
        sync_plasmoid_qml "pkgbuilds/pearos-dock/package/contents/ui" "/usr/share/plasma/plasmoids/PearDock" \
            || sync_plasmoid_qml "vendor/pkgbuilds/pearos-dock/package/contents/ui" "/usr/share/plasma/plasmoids/PearDock" \
            || warn "  -> could not sync PearDock (still using installed version)"
    else
        mkdir -p /usr/share/plasma/plasmoids/PearDock/contents/ui 2>/dev/null || true
        log "Syncing PearDock (creating target dir)..."
        sync_plasmoid_qml "pkgbuilds/pearos-dock/package/contents/ui" "/usr/share/plasma/plasmoids/PearDock" 2>/dev/null \
            || sync_plasmoid_qml "vendor/pkgbuilds/pearos-dock/package/contents/ui" "/usr/share/plasma/plasmoids/PearDock" 2>/dev/null \
            || warn "  -> PearDock sync attempted (target was missing, may need reinstall)"
    fi

    # PearNotch — standalone app, not a plasmoid; just warn if missing and skip gracefully
    if [ -f /usr/bin/pearos-notch ] || [ -d /usr/share/plasma/plasmoids/pearos-notch ] || [ -d /usr/share/plasma/plasmoids/PearNotch ]; then
        log "pearos-notch is a standalone app (/usr/bin/pearos-notch) — skipping QML plasmoid sync (app updates via package upgrade)"
    fi
fi
# restart the shell so QML changes take effect immediately
if (( DRY_RUN )); then
    log "[dry-run] would run: kquitapp6 plasmashell && sleep 2 && kstart plasmashell &"
else
    if command -v kquitapp6 >/dev/null 2>&1 && command -v kstart >/dev/null 2>&1; then
        log "Restarting plasmashell to apply interface changes..."
        kquitapp6 plasmashell 2>/dev/null; sleep 2; kstart plasmashell >/dev/null 2>&1 & disown || true
    fi
fi

# ---- 4) Package upgrades -----------------------------------------------------
if (( FULL )); then
    log "Upgrading all packages (pacman -Syu) — this may take a while..."
    pacman -Syu --noconfirm || warn "pacman -Syu failed (check network/repos)"
else
    log "Skipping package upgrade (use 'pearos-update --full' for kernel/Plasma/app updates)"
fi

touch /var/lib/pearos-update.stamp
log "Done. Log out and back in for all theming changes to take effect."
