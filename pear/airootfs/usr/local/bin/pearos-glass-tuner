#!/usr/bin/env bash
# pearos-glass-tuner — live-adjust KWin blur strength
# Usage: pearos-glass-tuner [strength 0-30] [--reset]
set -e
STRENGTH="${1:-12}"
if [[ "$1" == "--reset" ]]; then STRENGTH=12; fi
if ! [[ "$STRENGTH" =~ ^[0-9]+$ ]] || (( STRENGTH > 30 )); then
    echo "Usage: $0 [0-30]  (default 12, 0 disables blur)"
    exit 1
fi
CONFIG="$HOME/.config/kwinrc"
# Backup
cp -n "$CONFIG" "$CONFIG.bak.pearos" 2>/dev/null || true
kwriteconfig6 --file kwinrc --group Effect-Blur --key BlurStrength "$STRENGTH" 2>/dev/null \
 || kwriteconfig5 --file kwinrc --group Effect-Blur --key BlurStrength "$STRENGTH" 2>/dev/null || true
kwriteconfig6 --file kwinrc --group Effect-Blur --key NoiseStrength 0 2>/dev/null \
 || kwriteconfig5 --file kwinrc --group Effect-Blur --key NoiseStrength 0 2>/dev/null || true
# Reconfigure running KWin via DBus
if qdbus6 org.kde.KWin /Effects org.kde.kwin.Effects.reconfigure 2>/dev/null; then
    echo "[pearos-glass-tuner] blur strength set to $STRENGTH via qdbus6"
elif qdbus org.kde.KWin /Effects org.kde.kwin.Effects.reconfigure 2>/dev/null; then
    echo "[pearos-glass-tuner] blur strength set to $STRENGTH via qdbus"
else
    echo "[pearos-glass-tuner] blur strength set to $STRENGTH — log out/in to apply (KWin not running)"
fi
echo "BlurStrength=$STRENGTH written to $CONFIG"
