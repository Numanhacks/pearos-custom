# pearOS kwinrc — synced radius 8px + blur + performance
# Fixes: square window corners poke, glassmorphism, 3s button delay

[Compositing]
Backend=OpenGL
GLCore=false
OpenGLIsUnsafe=false
WindowsBlockCompositing=false
AnimationSpeed=2
HiddenPreviews=5
LatencyPolicy=Low
MaxFPS=144
RefreshRate=0

[Effect-Blur]
BlurStrength=12
NoiseStrength=0

[Plugins]
blurEnabled=true
contrastEnabled=true
kwin4_effect_blurEnabled=true
kwin4_effect_translucencyEnabled=true

[org.kde.kdecoration2]
library=org.kde.kwin.aurorae
theme=WhiteSur-dark

[Windows]
FocusPolicy=ClickToFocus
DelayFocusInterval=0
BorderSnapZone=10
WindowSnapZone=10
CenterSnapZone=10
SnapOnlyWhenOverlapping=false
RollOverDesktops=true
FocusStealingPreventionLevel=1

[MouseBindings]
CommandTitlebarWheel=Nothing
CommandWindowWheel=Nothing

[Desktops]
Number=1
Rows=1

[Effect-PresentWindows]
LayoutMode=0

[Effect-WindowView]
BorderActivateAll=9
