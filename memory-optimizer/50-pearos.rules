{ "name": "Xwayland", "type": "good" }
{ "name": "pipewire", "type": "good" }
{ "name": "wireplumber", "type": "good" }
{ "name": "systemd-oomd", "type": "good" }
{ "name": "dolphin", "type": "good" }
{ "name": "konsole", "type": "good" }
{ "name": "firefox", "type": "good" }
{ "name": "seafari", "type": "good" }
{ "name": "electron", "type": "heavy" }
{ "name": "electron43", "type": "heavy" }
{ "name": "btrfs", "type": "heavy" }
{ "name": "updatedb", "type": "heavy" }
{ "name": "pacman", "type": "heavy" }
{ "name": "gcc", "type": "heavy" }
{ "name": "cc1plus", "type": "heavy" }
{ "name": "make", "type": "heavy" }
